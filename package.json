{
  "name": "herdr-broadcast",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Herdr plugin: send one prompt to many agents and record delivery results",
  "scripts": {
    "web": "bun src/main.ts web",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun scripts/test-suite.ts unit",
    "test:integration": "bun scripts/test-suite.ts integration",
    "test:e2e": "bun scripts/e2e.ts",
    "build": "bun run typecheck && bun scripts/build.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@xterm/headless": "5.5.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/xterm": "5.5.0"
  }
}
